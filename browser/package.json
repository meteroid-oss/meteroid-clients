{
  "name": "@meteroid/browser",
  "version": "0.26.0",
  "description": "Meteroid in the browser: entitlements, usage, subscriptions and billing embeds for the signed-in customer",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/meteroid.global.js",
  "jsdelivr": "./dist/meteroid.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./meteroid.global.js": "./dist/meteroid.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node build.mjs",
    "clean": "rm -rf dist test_build",
    "check": "biome check",
    "check:fix": "biome check --write",
    "fmt": "biome format --write",
    "lint": "biome lint",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test test_build/test/*.test.js && npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^28.0.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "meteroid",
    "billing",
    "entitlements",
    "feature-flags",
    "usage",
    "subscription",
    "browser"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/meteroid-oss/meteroid-clients",
    "directory": "browser"
  },
  "bugs": {
    "url": "https://github.com/meteroid-oss/meteroid-clients/issues"
  },
  "homepage": "https://github.com/meteroid-oss/meteroid-clients/tree/main/browser"
}
