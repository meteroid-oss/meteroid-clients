{
  "name": "scribe-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The Scribe demo SPA. One frontend, any backend - point VITE_API_BASE_URL at it.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript ../openapi.yaml --output src/api/schema.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
