{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "initial-version": "0.1.0",
  "tag-separator": "/",
  "packages": {
    "rust": {
      "release-type": "rust",
      "component": "rust"
    },
    "typescript": {
      "release-type": "node",
      "extra-files": [
        "src/request.ts"
      ],
      "component": "typescript"
    },
    "python": {
      "release-type": "python",
      "component": "python"
    },
    "go": {
      "release-type": "go",
      "version-file": "version.go",
      "component": "go"
    },
    "java": {
      "release-type": "simple",
      "extra-files": [
        "gradle.properties",
        "src/main/java/com/meteroid/Version.java"
      ],
      "component": "java"
    }
  }
}
