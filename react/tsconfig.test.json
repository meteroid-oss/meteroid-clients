{
  // Tests are compiled to CommonJS in `test_build/` and run with `node --test`.
  // `@meteroid/browser` resolves to its build: run `npm run build -w browser` first.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./test_build",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "test/*.ts", "test/*.tsx"]
}
