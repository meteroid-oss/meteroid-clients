{
  "$schema": "https://biomejs.dev/schemas/2.1.4/schema.json",
  // The formatter settings below must stay in sync with the codegen
  // postprocessor (`CodegenLanguage::TypeScript` in
  // `codegen/src/postprocessing.rs`), otherwise `biome check` disagrees with
  // the freshly generated files under `src/api` and `src/models`.
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.js",
      "**/*.mjs",
      "**/*.cjs",
      "!dist",
      "!test_build",
      "!node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 90
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "es5"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  },
  "overrides": [
    {
      // `src/index.ts`, `src/api` and `src/models` are generated by
      // `./regen_openapi.py`; their
      // shape is decided by the jinja templates in
      // `codegen/templates/typescript`, not by hand. The rules below are
      // deliberately not applied there:
      //   - useLiteralKeys: serializers index JSON by its wire key
      //     (`object["invoice_number"]`) so that keys which are not valid JS
      //     identifiers keep working.
      //   - noEmptyInterface: schemas with no properties must stay interfaces,
      //     because discriminated-union variants `extends` them.
      //   - noUnusedFunctionParameters: the serializers for those empty
      //     schemas take an argument they do not read.
      //   - organizeImports: import order is produced by the codegen and is
      //     stable across regenerations.
      "includes": ["src/index.ts", "src/api/**", "src/models/**"],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          },
          "suspicious": {
            "noEmptyInterface": "off"
          },
          "correctness": {
            "noUnusedFunctionParameters": "off"
          }
        }
      },
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      }
    }
  ]
}
